# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 通知通道：feishu 或 serverchan3（默认：feishu）
NOTIFY_CHANNEL=feishu

# 飞书配置（NOTIFY_CHANNEL=feishu 时使用）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# Server酱³ 配置（NOTIFY_CHANNEL=serverchan3 时使用）
SERVERCHAN3_SENDKEY=your-default-sendkey

# 飞书策略专属 Webhook（可选）
# STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# STRATEGY_WEBHOOK_FLAG=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# STRATEGY_WEBHOOK_SHAKEOUT=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# STRATEGY_WEBHOOK_LIMIT_DOWN=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# STRATEGY_WEBHOOK_RPS=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=https://open.feishu.cn/open-apis/bot/v2/hook/your-token

# Server酱³ 策略专属 SendKey（可选）
# STRATEGY_SENDKEY_MA_VOLUME=your-ma-volume-sendkey
# STRATEGY_SENDKEY_TURTLE=your-turtle-sendkey
# STRATEGY_SENDKEY_FLAG=your-flag-sendkey
# STRATEGY_SENDKEY_SHAKEOUT=your-shakeout-sendkey
# STRATEGY_SENDKEY_LIMIT_DOWN=your-limit-down-sendkey
# STRATEGY_SENDKEY_RPS=your-rps-sendkey
# STRATEGY_SENDKEY_PRIVATE_PLACEMENT=your-private-placement-sendkey

# Facade 只使用 NOTIFY_CHANNEL 选中的通道，不会同时发送
